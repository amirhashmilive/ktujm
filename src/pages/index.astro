---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Academic Notes & Ph.D. Scholars Commons">
  <div class="hero" style="border-radius: var(--radius); margin-bottom: 32px;">
    <h1>KTUJM Scholars</h1>
    <p>
      An independent, open-access academic repository and mentorship network created by alumni and maintained by Ph.D. scholars of Kushabhau Thakre Patrakarita Avam Jansanchar Vishwavidyalaya.
    </p>
    <div style="margin-top: 20px; display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
      <a href="/ktujm/courses/mamc/" style="background: #fff; color: var(--color-primary); padding: 10px 20px; border-radius: 6px; font-weight: 600;">
        Explore MAMC Notes (550+ Topics)
      </a>
      <a href="/ktujm/editorial-board/" style="background: rgba(255,255,255,0.2); color: #fff; padding: 10px 20px; border-radius: 6px; font-weight: 600;">
        3-Tier Editorial Board
      </a>
      <a href="/ktujm/contribute/" style="background: rgba(255,255,255,0.2); color: #fff; padding: 10px 20px; border-radius: 6px; font-weight: 600;">
        How to Contribute
      </a>
    </div>
  </div>

  <section style="margin-bottom: 40px;">
    <h2>Academic Syllabus & Notes Repository</h2>
    <p style="color: var(--color-text-muted); margin-bottom: 20px;">
      Structured, peer-reviewed notes organized by Course &rarr; Semester &rarr; Paper &rarr; Unit &rarr; Topic.
    </p>

    <div class="card-grid">
      <div class="card">
        <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 12px;">
          <h3 style="margin: 0;"><a href="/ktujm/courses/mamc/">MAMC</a></h3>
          <span class="badge badge-published">Active Hub</span>
        </div>
        <p style="font-size: 14px; color: var(--color-text-muted); margin-bottom: 12px;">
          Master of Arts in Mass Communication (Ordinance 08). Complete 4-semester coverage, 20 papers, 100 units, and 554 topic stubs with exam questions.
        </p>
        <a href="/ktujm/courses/mamc/" style="font-weight: 600; font-size: 14px;">Open Course Syllabus & Notes &rarr;</a>
      </div>

      <div class="card">
        <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 12px;">
          <h3 style="margin: 0;">MJ (Master of Journalism)</h3>
          <span class="badge badge-draft">Phase 2</span>
        </div>
        <p style="font-size: 14px; color: var(--color-text-muted); margin-bottom: 12px;">
          Ordinance 1[A]. Print, investigative journalism, desk reporting, and media laws. Coming next under Department of Journalism coordination.
        </p>
        <a href="/ktujm/courses/" style="font-size: 14px;">View syllabus index &rarr;</a>
      </div>

      <div class="card">
        <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 12px;">
          <h3 style="margin: 0;">MSW (Master of Social Work)</h3>
          <span class="badge badge-draft">Phase 2</span>
        </div>
        <p style="font-size: 14px; color: var(--color-text-muted); margin-bottom: 12px;">
          Ordinance 21. Rural community work, social legislation, psychiatric counseling, and tribal development in Chhattisgarh.
        </p>
        <a href="/ktujm/courses/" style="font-size: 14px;">View syllabus index &rarr;</a>
      </div>

      <div class="card">
        <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 12px;">
          <h3 style="margin: 0;">MBA (Media Management)</h3>
          <span class="badge badge-draft">Phase 2</span>
        </div>
        <p style="font-size: 14px; color: var(--color-text-muted); margin-bottom: 12px;">
          Ordinance 13. Media economics, event marketing, PR campaigns, and digital platform business models.
        </p>
        <a href="/ktujm/courses/" style="font-size: 14px;">View syllabus index &rarr;</a>
      </div>
    </div>
  </section>

  <section style="margin-bottom: 40px;">
    <h2>3-Tier Editorial Governance Model</h2>
    <p style="color: var(--color-text-muted); margin-bottom: 20px;">
      Built to survive scholar turnover and graduation through systematic handovers and academic recognition.
    </p>
    <div class="card-grid">
      <div class="card" style="border-left: 4px solid var(--color-primary);">
        <h4>Tier 1: Founder & Permanent Patron</h4>
        <p style="font-size: 14px; color: var(--color-text-muted);">
          <strong>Amir Hashmi</strong> (Alumnus & Ph.D. Scholar). Holds final vision, platform sustainability, alumni outreach, and senior appointments.
        </p>
      </div>
      <div class="card" style="border-left: 4px solid var(--color-primary-light);">
        <h4>Tier 2: Managing Editor</h4>
        <p style="font-size: 14px; color: var(--color-text-muted);">
          1-year rotational term appointed from active senior Ph.D. scholars. Coordinates editorial workflow and calendar.
        </p>
      </div>
      <div class="card" style="border-left: 4px solid #38a169;">
        <h4>Tier 3: Departmental Coordinators</h4>
        <p style="font-size: 14px; color: var(--color-text-muted);">
          1–2 scholars per academic department. Responsible for syllabus fidelity, note verifications, and student submissions.
        </p>
      </div>
    </div>
    <p style="text-align: right; margin-top: 12px;">
      <a href="/ktujm/editorial-board/" style="font-weight: 600;">Learn more about our Succession & Shadowing Rule &rarr;</a>
    </p>
  </section>

  <section>
    <h2>Student Life & Community Commons</h2>
    <div class="card-grid">
      <div class="card">
        <h4>🎓 Career & Alumni Network</h4>
        <p style="font-size: 14px; color: var(--color-text-muted);">
          Featuring standardized 8–10 question alumni interviews, podcast sessions, and guidance from media practitioners.
        </p>
        <a href="/ktujm/career-alumni/" style="font-size: 14px;">Visit Alumni Hub &rarr;</a>
      </div>
      <div class="card">
        <h4>🎪 Clubs & Campus Events</h4>
        <p style="font-size: 14px; color: var(--color-text-muted);">
          Student-organized cultural, literary, and media events schedule, workshops, and inter-university competitions.
        </p>
        <a href="/ktujm/clubs-events/" style="font-size: 14px;">View Calendar &rarr;</a>
      </div>
      <div class="card">
        <h4>🛒 Student Marketplace</h4>
        <p style="font-size: 14px; color: var(--color-text-muted);">
          Book exchange, study materials trade, peer camera gear rentals, and lost-and-found notice board.
        </p>
        <a href="/ktujm/marketplace/" style="font-size: 14px;">Browse Commons &rarr;</a>
      </div>
    </div>
  </section>
</BaseLayout>
