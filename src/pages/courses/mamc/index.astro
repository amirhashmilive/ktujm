---
// src/pages/courses/mamc/index.astro
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TentativeNotice from '../../../components/TentativeNotice.astro';
import fs from 'fs';
import path from 'path';
import yaml from 'js-yaml';

const breadcrumbs = [
  { label: 'Courses', href: '/ktujm/courses/' },
  { label: 'MAMC' }
];

const yamlPath = path.resolve('content/syllabus/mamc.yaml');
const syllabusData = yaml.load(fs.readFileSync(yamlPath, 'utf-8')) as any;
---

<BaseLayout title="MAMC — Master of Arts (Mass Communication)" breadcrumbs={breadcrumbs}>
  <div style="margin-bottom: 24px;">
    <h1>Master of Arts (Mass Communication)</h1>
    <p style="font-size: 16px; color: var(--color-text-muted); margin-top: 4px;">
      Ordinance No. 08 • Department of Mass Communication • 2 Years / 4 Semesters • 20 Papers • 554 Topics
    </p>
  </div>

  <TentativeNotice officialUrl={syllabusData.official_syllabus_url} />

  <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius); padding: 16px 20px; margin-bottom: 32px;">
    <h3 style="margin-top: 0; font-size: 16px;">Course Overview & Evaluation Scheme</h3>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; font-size: 14px; margin-top: 12px;">
      <div><strong>Total Semesters:</strong> 4</div>
      <div><strong>Total Theory & Practical Papers:</strong> 20</div>
      <div><strong>Marks per Paper:</strong> 100 (Max) / 36 (Pass)</div>
      <div><strong>Dissertation/Project:</strong> MAMC-404 (200 Marks)</div>
    </div>
  </div>

  {syllabusData.semesters.map((sem: any) => (
    <section style="margin-bottom: 40px;">
      <h2 style="border-bottom: 2px solid var(--color-primary); padding-bottom: 8px; margin-bottom: 16px;">
        Semester {sem.semester}
      </h2>

      <div class="card-grid">
        {sem.papers.map((paper: any) => (
          <div class="card">
            <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 8px;">
              <span style="font-weight: 700; color: var(--color-primary-light); font-size: 15px;">
                {paper.paper_code}
              </span>
              <span class="badge badge-published" style="font-size: 10px;">
                {paper.course_type} • 5 Units
              </span>
            </div>
            <h3 style="font-size: 16px; margin: 0 0 8px;">
              <a href={`/ktujm/courses/mamc/sem-${sem.semester}/${paper.paper_code.toLowerCase()}/`}>
                {paper.paper_name}
              </a>
            </h3>
            <p style="font-size: 13px; color: var(--color-text-muted); margin-bottom: 12px;">
              Max: {paper.max_marks} | Pass: {paper.pass_marks}
            </p>
            <div style="font-size: 12px; color: var(--color-text-muted); line-height: 1.4; margin-bottom: 16px;">
              {paper.units.map((u: any) => u.title).join(' • ')}
            </div>
            <a href={`/ktujm/courses/mamc/sem-${sem.semester}/${paper.paper_code.toLowerCase()}/`} style="font-weight: 600; font-size: 13px;">
              View All 5 Units & Topics &rarr;
            </a>
          </div>
        ))}
      </div>
    </section>
  ))}
</BaseLayout>
