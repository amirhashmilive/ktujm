---
// src/pages/editorial-board.astro
import BaseLayout from '../layouts/BaseLayout.astro';

const breadcrumbs = [{ label: 'Editorial Board' }];
---

<BaseLayout title="Editorial Board & 3-Tier Governance Model" breadcrumbs={breadcrumbs}>
  <h1>3-Tier Editorial Governance Model</h1>
  <p style="color: var(--color-text-muted); font-size: 16px; margin-bottom: 24px;">
    A self-sustaining academic journal and student-run media house structure designed to survive Ph.D. scholar turnover.
  </p>

  <div class="card" style="border-left: 4px solid var(--color-primary); margin-bottom: 32px;">
    <h2 style="margin-top: 0; color: var(--color-primary);">Why a 3-Tier Governance Structure?</h2>
    <p>
      The greatest challenge faced by university initiatives is losing momentum when student leaders and Ph.D. scholars complete their research and graduate. 
      <strong>KTUJM Scholars</strong> addresses this systemic turnover by adopting an institutional model inspired by peer-reviewed academic journals: permanent patron oversight, an annual rotational managing editor, and department-level scholar coordinators bound by mandatory handover rules.
    </p>
  </div>

  <section style="margin-bottom: 40px;">
    <h2>The 3 Tiers of Responsibility</h2>

    <div style="display: flex; flex-direction: column; gap: 20px; margin-top: 20px;">
      <div class="card" style="border-top: 3px solid #2b6cb0;">
        <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 8px;">
          <h3 style="margin: 0; color: #2b6cb0;">Tier 1: Founder & Permanent Patron</h3>
          <span class="badge" style="background: #ebf8ff; color: #2b6cb0;">Permanent Oversight</span>
        </div>
        <p style="font-size: 14px; font-weight: 600; margin-bottom: 8px;">
          Held by: Amir Hashmi (Alumnus & Ph.D. Scholar)
        </p>
        <ul style="font-size: 14px; margin-left: 20px; line-height: 1.6;">
          <li>Maintains the long-term vision, hosting infrastructure, and institutional neutrality of the platform.</li>
          <li>Oversees senior editorial appointments and approves the annual Managing Editor selection.</li>
          <li>Leads major alumni outreach, high-profile interviews, and media partnership initiatives.</li>
          <li>Acts as the permanent steward ensuring the platform remains non-commercial, advertisement-free, and student-focused.</li>
        </ul>
      </div>

      <div class="card" style="border-top: 3px solid #d69e2e;">
        <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 8px;">
          <h3 style="margin: 0; color: #b7791f;">Tier 2: Managing Editor</h3>
          <span class="badge" style="background: #fefcbf; color: #744210;">1-Year Rotational Term</span>
        </div>
        <p style="font-size: 14px; font-weight: 600; margin-bottom: 8px;">
          Role: Senior Ph.D. Scholar (Current term: 2026–2027)
        </p>
        <ul style="font-size: 14px; margin-left: 20px; line-height: 1.6;">
          <li>Maintains the active editorial publishing calendar and coordinates weekly submission reviews.</li>
          <li>Acts as the operational bridge between the Founder and the campus student body.</li>
          <li>Enforces note quality standards, plagiarism screening, and proper citation formats before publishing.</li>
          <li>Supervises the Departmental Coordinators and guides junior scholars in editorial verification.</li>
        </ul>
      </div>

      <div class="card" style="border-top: 3px solid #38a169;">
        <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 8px;">
          <h3 style="margin: 0; color: #276749;">Tier 3: Departmental Coordinators</h3>
          <span class="badge" style="background: #c6f6d5; color: #22543d;">1–2 Scholars per Department</span>
        </div>
        <p style="font-size: 14px; font-weight: 600; margin-bottom: 8px;">
          Role: Active Ph.D. Scholars across all 9 University Academic Departments
        </p>
        <ul style="font-size: 14px; margin-left: 20px; line-height: 1.6;">
          <li>Collect, curate, and review study notes, model question papers, and reading recommendations for their respective departments.</li>
          <li>Verify curriculum adherence against official university ordinances and notify the board of any syllabus changes.</li>
          <li>Nominate impressive undergraduate and postgraduate students for contributor credits and mentorship.</li>
          <li>Identify distinguished alumni from their department to feature in our Career & Alumni spotlight series.</li>
        </ul>
      </div>
    </div>
  </section>

  <section style="margin-bottom: 40px;">
    <h2>The Mandatory Succession & Shadowing Rule</h2>
    <div class="card" style="background: #fffaf0; border: 1px solid #feebc8;">
      <h3 style="margin-top: 0; color: #c05621;">Guaranteeing Continuity across Graduating Batches</h3>
      <p style="font-size: 14px; line-height: 1.7; color: #7b341e;">
        To prevent knowledge loss when senior researchers complete their degrees:
      </p>
      <blockquote style="margin: 12px 0; padding: 12px 16px; background: #fff; border-left: 4px solid #dd6b20; font-size: 14px; color: #4a5568;">
        <strong>The Shadowing Rule:</strong> Every Departmental Coordinator and Managing Editor must recruit, mentor, and actively shadow a junior Ph.D. scholar (1st or 2nd year) for <strong>at least three months prior to submitting their doctoral thesis</strong>. The junior scholar participates in editorial meetings, manages git pull requests, and learns the verification protocol to ensure a seamless handover upon the senior scholar's graduation.
      </blockquote>
    </div>
  </section>

  <section style="margin-bottom: 40px;">
    <h2>Contributor Recognition & Academic Credit Policy</h2>
    <div class="card">
      <p style="font-size: 14px; line-height: 1.6;">
        Academic recognition is central to our open-access philosophy. Every verified note, article, or interview published on this platform permanently carries:
      </p>
      <ul style="font-size: 14px; margin: 12px 0 12px 20px; line-height: 1.6;">
        <li><strong>Student Contributor:</strong> Name, enrollment batch, and academic department.</li>
        <li><strong>Ph.D. Scholar Verifier:</strong> Name, research specialization, and official editorial credit.</li>
        <li><strong>Revision History:</strong> Timestamp and version notes tracked transparently via GitHub commit history.</li>
      </ul>
      <p style="font-size: 13px; color: var(--color-text-muted);">
        Scholars and student editors receive an official certificate of editorial service and public attribution suitable for their academic curricula vitae (CV).
      </p>
    </div>
  </section>

  <section>
    <h2>Current Editorial Board Roster (2026–2027)</h2>
    <table>
      <thead>
        <tr>
          <th>Designation</th>
          <th>Name</th>
          <th>Department / Affiliation</th>
          <th>Role</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><strong>Founder & Permanent Patron</strong></td>
          <td>Amir Hashmi</td>
          <td>Alumnus & Ph.D. Scholar</td>
          <td>Strategic Oversight, Infrastructure & Patronage</td>
        </tr>
        <tr>
          <td><strong>Managing Editor (2026-27)</strong></td>
          <td><em>Appointed Scholar</em></td>
          <td>Mass Communication / Journalism</td>
          <td>Editorial Workflow & Calendar Coordination</td>
        </tr>
        <tr>
          <td><strong>Coordinator — Mass Communication</strong></td>
          <td><em>Open Nomination</em></td>
          <td>Dept. of Mass Communication</td>
          <td>MAMC Syllabus & Practical Notes Verification</td>
        </tr>
        <tr>
          <td><strong>Coordinator — Journalism</strong></td>
          <td><em>Open Nomination</em></td>
          <td>Dept. of Journalism</td>
          <td>MJ Notes & Print Newsroom Case Studies</td>
        </tr>
        <tr>
          <td><strong>Coordinator — Advertising & PR</strong></td>
          <td><em>Open Nomination</em></td>
          <td>Dept. of PR & Advertising</td>
          <td>Campaign Briefs & Corporate Case Studies</td>
        </tr>
        <tr>
          <td><strong>Coordinator — Electronic Media</strong></td>
          <td><em>Open Nomination</em></td>
          <td>Dept. of Electronic Media</td>
          <td>Studio & Broadcast Production Guides</td>
        </tr>
        <tr>
          <td><strong>Coordinator — Social Work</strong></td>
          <td><em>Open Nomination</em></td>
          <td>Dept. of Social Work</td>
          <td>Field Work Manuals & Rural Welfare Notes</td>
        </tr>
      </tbody>
    </table>
  </section>
</BaseLayout>
